# =============================================================================
# Homework Answer Assistant — environment variables
# =============================================================================

DEMO_MODE=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo-mode admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ─────────────────────────────────────────────────────────────────────────────
# VISION / OCR  —  اختر واحد فقط (الأولوية لـ Anthropic إذا الاثنين موجودين)
# ─────────────────────────────────────────────────────────────────────────────

# الخيار 1: Google Gemini — مجاني تماماً، 1500 طلب/يوم، بدون بطاقة بنكية
# احصل على مفتاحك من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# الخيار 2: Anthropic Claude — مدفوع، جودة أعلى
AI_API_KEY=
AI_ANSWER_MODEL=claude-sonnet-4-6
AI_VISION_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────────────────────

EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=50
MAX_OCR_PAGES=8
PDF_TEXT_MIN_LENGTH=50
MAX_QUESTIONS_PER_REQUEST=10
RATE_LIMIT_COUNT=20
RATE_LIMIT_WINDOW_SECONDS=600
SEARCH_CONFIDENCE_THRESHOLD=0.78
AI_TIMEOUT_MS=30000
FILE_PROCESSING_TIMEOUT_MS=60000
