# =============================================================================
# Homework Answer Assistant — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# true  → in-memory demo data; scanned PDFs get placeholder content (no API key needed)
# false → requires AI_API_KEY for scanned PDF OCR; will return a clear error if missing
DEMO_MODE=true

# ── Supabase (required when DEMO_MODE=false) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix with NEXT_PUBLIC_, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# ── Demo-mode admin login ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ── AI provider — Answer generation (Anthropic) ──────────────────────────────
AI_API_KEY=
AI_ANSWER_MODEL=claude-sonnet-4-6

# ── Vision / OCR model (used for scanned/image-based PDFs) ───────────────────
# Uses the same AI_API_KEY. Override model name here if needed.
# When AI_API_KEY is empty and DEMO_MODE=false, scanned PDFs return an error.
AI_VISION_MODEL=claude-sonnet-4-6
VISION_MODEL=claude-sonnet-4-6

# ── Embeddings provider (separate from AI answer provider) ────────────────────
# Leave empty to fall back to trigram + keyword search (safe, fully functional).
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── Upstash Redis (optional — multi-instance rate limiting) ──────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── PDF Processing ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=15
MAX_PDF_PAGES=10
# Pages rendered to images for vision OCR (≤ MAX_PDF_PAGES)
MAX_OCR_PAGES=8
# Minimum extracted text length before a PDF is treated as scanned
PDF_TEXT_MIN_LENGTH=50

# ── Safety / rate limits ──────────────────────────────────────────────────────
MAX_QUESTIONS_PER_REQUEST=10
RATE_LIMIT_COUNT=20
RATE_LIMIT_WINDOW_SECONDS=600
SEARCH_CONFIDENCE_THRESHOLD=0.78
AI_TIMEOUT_MS=30000
FILE_PROCESSING_TIMEOUT_MS=60000
